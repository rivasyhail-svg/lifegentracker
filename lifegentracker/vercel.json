{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "buildCommand": "echo skip-build",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/**,public/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
